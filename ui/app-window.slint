import {
    CheckBox, CheckState, Dialog, FilledButton, Icon, MaterialPalette, MaterialText,
    MaterialTypography, MaterialWindow, StateLayerArea, TextButton, TextField,
} from "@material";
import { SakuraTheme } from "sakura-theme.slint";
import { Entry } from "components/app-card.slint";
import { AppList } from "components/app-list.slint";
import { ConfirmDialog } from "components/confirm-dialog.slint";
import { FilterMenu } from "components/filter-menu.slint";
import { LeftoverPanel } from "components/leftover-panel.slint";
import { MenuEntry, MenuPanel } from "components/menu-panel.slint";
import { PageTabs, TabItem } from "components/page-tabs.slint";
import { ProgressPanel } from "components/progress-panel.slint";
import { ReportPanel } from "components/report-panel.slint";
import { SearchField } from "components/search-field.slint";

export { Entry }

component TitlebarButton {
    in property <image> icon;
    in property <string> label;
    callback clicked();

    width: 30px;
    height: 30px;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    StateLayerArea {
        width: 100%;
        height: 100%;
        border-radius: 15px;
        color: MaterialPalette.on_surface;
        clicked => { root.clicked(); }

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: MaterialPalette.on_surface_variant;
            width: 18px;
        }
    }
}

component ActionPill {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled;

    callback clicked();

    height: 48px;
    width: pill_layout.preferred-width;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 24px;
        background: MaterialPalette.primary_container;
        clip: true;

        StateLayerArea {
            width: 100%;
            height: 100%;
            border-radius: 24px;
            color: MaterialPalette.on_primary_container;
            clicked => { if root.enabled { root.clicked(); } }

            pill_layout := HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        source: root.icon;
                        colorize: MaterialPalette.on_primary_container;
                        width: 20px;
                    }
                }

                Text {
                    text: root.text;
                    font-size: 16px;
                    font-weight: 500;
                    letter-spacing: 0.15px;
                    color: MaterialPalette.on_primary_container;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component AppWindow inherits MaterialWindow {
    title: "Sakura Uninstaller";
    icon: @image-url("icons/sakura.svg");
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 585px;
    default-font-family: "Segoe UI";
    no-frame: true;
    background: transparent;
    resize-border-width: root.maximized ? 0px : 6px;

    in property <bool> italian;
    in property <bool> busy;
    in property <bool> silent-supported;
    in property <bool> only-portable;
    in property <bool> status-error;
    in property <bool> updates-configured;
    in property <string> update-version;
    in-out property <bool> auto-update;
    in-out property <bool> diagnostics;
    in property <string> diagnostics-host;
    in property <int> selected-count;
    in property <int> available-count;
    in property <int> residue-count;
    in property <int> saved-count;
    in property <[Entry]> entries;
    in property <string> status;
    in property <string> report-text;
    in property <bool> has-report;
    in property <bool> report-has-older;
    in property <int> report-offset;
    in property <string> confirmation-detail;
    in property <bool> offer-leftover-review;
    in-out property <string> search-text;
    in-out property <bool> silent;
    in-out property <int> page;
    in-out property <int> profile-index: 1;
    in-out property <int> filter-index;
    in-out property <bool> menu-open: false;
    in-out property <bool> quick-menu-open: false;

    private property <length> corner-radius: root.maximized ? 0px : 24px;
    private property <length> titlebar-height: 56px;
    private property <length> footer-height: 78px;
    private property <length> footer-padding: (root.footer-height - 40px) / 2;
    private property <length> fab-size: 56px;
    private property <length> fab-left: root.width - 16px - root.fab-size;
    private property <length> fab-top: root.height - root.footer-height - 8px - root.fab-size;
    private property <string> primary-label: page == 0
        ? (only-portable ? (italian ? "Cerca residui" : "Scan leftovers") : (italian ? "Disinstalla" : "Uninstall"))
        : page == 1 ? (italian ? "Sposta in quarantena" : "Move to quarantine")
                    : (italian ? "Ripristina" : "Restore");
    private property <string> confirmation-label;
    private property <bool> confirmation-review: true;

    private property <[MenuEntry]> main-menu: [
        {
            text: root.italian ? "English" : "Italiano",
            icon: @image-url(""),
            trailing: "",
            visible: true,
            enabled: true,
            checkable: false,
            checked: false,
        },
        {
            text: root.italian ? "Registro attività" : "Activity log",
            icon: @image-url(""),
            trailing: "",
            visible: true,
            enabled: !root.busy,
            checkable: false,
            checked: false,
        },
        {
            text: root.italian ? "Aggiorna" : "Refresh",
            icon: @image-url(""),
            trailing: "",
            visible: true,
            enabled: !root.busy,
            checkable: false,
            checked: false,
        },
        {
            text: root.italian ? "Seleziona visibili" : "Select visible",
            icon: @image-url(""),
            trailing: "",
            visible: true,
            enabled: !root.busy && root.available-count > 0,
            checkable: false,
            checked: false,
        },
        {
            text: root.italian ? "Misura" : "Measure",
            icon: @image-url(""),
            trailing: "",
            visible: root.page == 0,
            enabled: !root.busy,
            checkable: false,
            checked: false,
        },
        {
            text: root.italian ? "Rapporti" : "Reports",
            icon: @image-url(""),
            trailing: "",
            visible: root.has-report,
            enabled: !root.busy,
            checkable: false,
            checked: false,
        },
        {
            text: root.italian ? "Modalità silenziosa" : "Quiet mode",
            icon: @image-url(""),
            trailing: "",
            visible: root.page == 0,
            enabled: !root.busy,
            checkable: true,
            checked: root.silent,
        },
        {
            text: root.italian ? "Impostazioni" : "Settings",
            icon: @image-url(""),
            trailing: "",
            visible: true,
            enabled: !root.busy,
            checkable: false,
            checked: false,
        },
    ];

    private property <[TabItem]> tabs: [
        {
            text: root.italian ? "Software installato" : "Installed software",
            count: 0,
            show_count: false,
        },
        {
            text: root.italian ? "Residui" : "Leftovers",
            count: root.residue-count,
            show_count: true,
        },
        {
            text: root.italian ? "Quarantena" : "Quarantine",
            count: root.saved-count,
            show_count: true,
        },
    ];

    callback load-page(int);
    callback language-changed();
    callback filter-changed();
    callback profile-changed();
    callback measure();
    callback close-apps();
    callback add-portable(string);
    callback check-update();
    callback install-update();
    callback update-preference();
    callback diagnostics-preference();
    callback send-diagnostics();
    callback browse-report(int);
    callback select(string, bool);
    callback select-visible();
    callback clear-selection();
    callback refresh();
    callback preview();
    callback prepare-action();
    callback confirm-action(bool);
    callback open-folder();
    callback close-window();
    callback minimize-window();
    callback toggle-maximize-window() -> bool;

    init => { MaterialPalette.schemes = SakuraTheme.schemes; }

    changed status => {
        if !root.busy && root.status != "" {
            notice.show();
        }
    }

    changed busy => {
        if !root.busy && root.status != "" {
            notice.show();
        }
    }

    public function activate-main-menu(index: int) {
        if index == 0 {
            root.language-changed();
        } else if index == 1 {
            root.open-folder();
        } else if index == 2 {
            root.refresh();
        } else if index == 3 {
            root.select-visible();
        } else if index == 4 {
            root.measure();
        } else if index == 5 {
            root.browse-report(0);
            report.show();
        } else if index == 6 {
            if !root.busy {
                root.silent = !root.silent;
            }
        } else {
            settings.show();
        }
    }

    shell := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.corner-radius;
        background: MaterialPalette.surface_container;
        border-width: 1px;
        border-color: MaterialPalette.outline_variant.with_alpha(50%);
        clip: true;

        VerticalLayout {
            titlebar := Rectangle {
                height: root.titlebar-height;
                vertical-stretch: 0;
                background: MaterialPalette.surface_container;

                WindowMoveArea {
                    width: 100%;
                    height: 100%;
                }

                MaterialText {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.title;
                    style: MaterialTypography.title_large;
                    color: MaterialPalette.on_surface;
                }

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-right: 10px;
                    spacing: 0px;

                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        padding-top: 1px;

                        window_buttons := HorizontalLayout {
                            spacing: 0px;

                        TitlebarButton {
                            icon: @image-url("icons/caret_down.svg");
                            label: root.italian ? "Riduci a icona" : "Minimize";
                            clicked => { root.minimize-window(); }
                        }

                        TitlebarButton {
                            icon: @image-url("icons/caret_up.svg");
                            label: root.maximized
                                ? (root.italian ? "Ripristina" : "Restore")
                                : (root.italian ? "Ingrandisci" : "Maximize");
                            clicked => { root.maximized = root.toggle-maximize-window(); }
                        }

                        TitlebarButton {
                            icon: @image-url("icons/close.svg");
                            label: root.italian ? "Chiudi" : "Close";
                            clicked => { root.close-window(); }
                        }
                        }
                    }
                }

                Rectangle {
                    x: 12px;
                    y: (parent.height - 48px) / 2 + 1px;
                    width: 48px;
                    height: 48px;

                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: MaterialPalette.primary;
                        clip: true;

                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            border-radius: 20px;
                            color: MaterialPalette.on_primary;
                            accessible-role: button;
                            accessible-label: root.italian ? "Menu di Sakura" : "Sakura menu";

                            clicked => {
                                root.menu-open = !root.menu-open;
                                root.quick-menu-open = false;
                            }

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("icons/gear.svg");
                                colorize: MaterialPalette.on_primary;
                                width: 20px;
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 10px;
                spacing: 20px;

                if root.page == 0 : HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;

                    SearchField {
                        horizontal-stretch: 1;
                        placeholder: root.italian ? "Cerca nome, editore o versione" : "Search name, publisher or version";
                        enabled: !root.busy;
                        text <=> root.search-text;
                        edited => { root.filter-changed(); }
                    }

                    FilterMenu {
                        label: root.italian ? "Filtro" : "Filter";
                        options: [
                            root.italian ? "Tutti" : "All",
                            root.italian ? "Rimovibili" : "Removable",
                            "MSIX",
                            root.italian ? "Portatili" : "Portable"
                        ];
                        current-index <=> root.filter-index;
                        selected(_) => { root.filter-changed(); }
                    }

                    FilterMenu {
                        label: root.italian ? "Scansione" : "Scan profile";
                        options: [
                            root.italian ? "Sicura" : "Safe",
                            root.italian ? "Equilibrata" : "Balanced",
                            root.italian ? "Approfondita" : "Deep"
                        ];
                        current-index <=> root.profile-index;
                        selected(_) => { root.profile-changed(); }
                    }
                }

                if root.busy : ProgressPanel {}

                if root.entries.length > 0 : AppList {
                    vertical-stretch: 1;
                    entries: root.entries;
                    busy: root.busy;
                    select(id, selected) => { root.select(id, selected); }
                }

                if root.entries.length == 0 : LeftoverPanel {
                    italian: root.italian;
                    busy: root.busy;
                    page: root.page;
                }
            }

            Rectangle {
                height: root.footer-height;
                vertical-stretch: 0;
                background: MaterialPalette.surface_container;

                PageTabs {
                    x: (parent.width - self.width) / 2;
                    y: root.footer-padding;
                    items: root.tabs;
                    current-index <=> root.page;
                    activated(index) => { root.load-page(index); }
                }

                MaterialText {
                    x: 32px;
                    y: root.footer-padding + (40px - self.height) / 2;
                    text: root.italian
                        ? "\{root.available-count} risultati · \{root.selected-count} selezionati"
                        : "\{root.available-count} results · \{root.selected-count} selected";
                    style: MaterialTypography.body_medium;
                    color: MaterialPalette.on_surface_variant;
                }
            }
        }

        if root.quick-menu-open : TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.quick-menu-open = false; }
        }

        if root.quick-menu-open : ActionPill {
            x: root.fab-left + root.fab-size - self.width;
            y: root.fab-top - 60px;
            text: root.primary-label;
            icon: root.page == 0 ? @image-url("icons/delete.svg") : @image-url("");
            enabled: !root.busy && root.selected-count > 0;
            clicked => {
                root.quick-menu-open = false;
                root.confirmation-label = root.primary-label;
                root.prepare-action();
                root.confirmation-review = true;
                confirmation.show();
            }
        }

        if root.quick-menu-open && root.page == 0 : ActionPill {
            x: root.fab-left + root.fab-size - self.width;
            y: root.fab-top - 120px;
            text: root.italian ? "Anteprima" : "Dry run";
            icon: @image-url("icons/folder.svg");
            enabled: !root.busy && root.selected-count > 0;
            clicked => {
                root.quick-menu-open = false;
                root.preview();
            }
        }

        if root.quick-menu-open && root.page == 0 : ActionPill {
            x: root.fab-left + root.fab-size - self.width;
            y: root.fab-top - 180px;
            text: root.italian ? "Aggiungi portatile" : "Add portable";
            icon: @image-url("icons/install_desktop.svg");
            enabled: !root.busy;
            clicked => {
                root.quick-menu-open = false;
                portable-dialog.show();
            }
        }

        Rectangle {
            x: root.fab-left;
            y: root.fab-top;
            width: root.fab-size;
            height: root.fab-size;
            border-radius: root.quick-menu-open ? root.fab-size / 2 : 24px;
            background: root.quick-menu-open ? MaterialPalette.primary : MaterialPalette.primary_container;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 4px;
            drop-shadow-spread: 3px;
            drop-shadow-color: #00000026;

            StateLayerArea {
                width: 100%;
                height: 100%;
                border-radius: root.quick-menu-open ? root.fab-size / 2 : 24px;
                color: root.quick-menu-open ? MaterialPalette.on_primary : MaterialPalette.on_primary_container;
                accessible-role: button;
                accessible-label: root.italian ? "Azioni rapide" : "Quick actions";

                clicked => {
                    root.quick-menu-open = !root.quick-menu-open;
                    root.menu-open = false;
                }

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.quick-menu-open ? @image-url("icons/close.svg") : @image-url("icons/more_vert.svg");
                    colorize: root.quick-menu-open ? MaterialPalette.on_primary : MaterialPalette.on_primary_container;
                    width: 24px;
                }
            }
        }

        if root.menu-open : Rectangle {
            width: 100%;
            height: 100%;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.menu-open = false; }
            }

            MenuPanel {
                x: 12px;
                y: root.titlebar-height + 6px;
                limit-height: root.height - root.titlebar-height - 20px;
                entries: root.main-menu;
                activated(index) => {
                    root.menu-open = false;
                    root.activate-main-menu(index);
                }
            }
        }

    }

    notice := Dialog {
        width: root.width;
        height: root.height;
        title: root.italian ? "Sakura Uninstaller" : "Sakura Uninstaller";
        actions: ["OK"];
        action-clicked => { self.close(); }
        MaterialText {
            width: 440px;
            wrap: word-wrap;
            text: root.status;
            color: root.status-error ? MaterialPalette.error : MaterialPalette.on_surface;
        }
    }

    settings := Dialog {
        width: root.width;
        height: root.height;
        title: root.italian ? "Impostazioni" : "Settings";
        actions: [root.italian ? "Chiudi" : "Close"];
        action-clicked => { self.close(); }
        VerticalLayout {
            width: 484px;
            spacing: 8px;
            HorizontalLayout {
                CheckBox {
                    width: 48px;
                    enabled: root.updates-configured;
                    accessible-label: root.italian ? "Controllo aggiornamenti automatico" : "Automatic update check";
                    check-state: root.auto-update ? CheckState.checked : CheckState.unchecked;
                    checked-state-changed(state) => {
                        if (state == CheckState.checked) != root.auto-update {
                            root.auto-update = state == CheckState.checked;
                            root.update-preference();
                        }
                    }
                }
                MaterialText {
                    text: root.italian ? "Controlla aggiornamenti all’avvio" : "Check for updates on startup";
                    vertical-alignment: center;
                }
            }
            if !root.updates-configured : MaterialText {
                text: root.italian ? "Il canale firmato non è configurato per questa build." : "This build has no configured signed update channel.";
                wrap: word-wrap;
                color: MaterialPalette.on_surface_variant;
            }
            HorizontalLayout {
                CheckBox {
                    width: 48px;
                    accessible-label: root.italian ? "Diagnostica locale" : "Local diagnostics";
                    check-state: root.diagnostics ? CheckState.checked : CheckState.unchecked;
                    checked-state-changed(state) => {
                        if (state == CheckState.checked) != root.diagnostics {
                            root.diagnostics = state == CheckState.checked;
                            root.diagnostics-preference();
                        }
                    }
                }
                MaterialText {
                    text: root.italian ? "Raccogli contatori diagnostici locali" : "Collect local diagnostic counts";
                    vertical-alignment: center;
                }
            }
            if root.diagnostics-host != "" : VerticalLayout {
                MaterialText {
                    text: root.italian
                        ? "Invia a \{root.diagnostics-host} solo il totale delle operazioni completate e con errori."
                        : "Send only totals of completed and failed operations to \{root.diagnostics-host}.";
                    wrap: word-wrap;
                    color: MaterialPalette.on_surface_variant;
                }
                TextButton {
                    horizontal-stretch: 0;
                    enabled: root.diagnostics && !root.busy;
                    text: root.italian ? "Invia contatori" : "Send counts";
                    clicked => { settings.close(); root.send-diagnostics(); }
                }
            }
            HorizontalLayout {
                TextButton {
                    enabled: root.updates-configured;
                    text: root.italian ? "Cerca aggiornamenti" : "Check for updates";
                    clicked => { settings.close(); root.check-update(); }
                }
                if root.update-version != "" : FilledButton {
                    text: root.italian ? "Installa \{root.update-version}" : "Install \{root.update-version}";
                    clicked => { settings.close(); root.install-update(); }
                }
            }
        }
    }

    portable-dialog := Dialog {
        width: root.width;
        height: root.height;
        title: root.italian ? "Aggiungi app portatile" : "Add portable app";
        actions: [root.italian ? "Annulla" : "Cancel", root.italian ? "Aggiungi" : "Add"];
        action-clicked(index) => {
            if index == 1 { root.add-portable(portable-path.text); }
            self.close();
        }
        portable-path := TextField {
            width: 488px;
            label: root.italian ? "Percorso completo del file .exe" : "Full path to the .exe";
        }
    }

    confirmation := ConfirmDialog {
        width: root.width;
        height: root.height;
        title: root.confirmation-label;
        italian: root.italian;
        details: root.confirmation-detail;
        offer-review: root.offer-leftover-review;
        review-after <=> root.confirmation-review;
        confirmed(review) => { root.confirm-action(review); }
    }

    report := ReportPanel {
        width: root.width;
        height: root.height;
        italian: root.italian;
        report-text: root.report-text;
        has-newer: root.report-offset > 0;
        has-older: root.report-has-older;
        browse(direction) => { root.browse-report(direction); }
    }
}

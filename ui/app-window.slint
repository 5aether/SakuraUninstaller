import {
    CheckBox, CheckState, Dialog, DropDownMenu, FilledButton, MaterialPalette,
    MaterialText, MaterialTypography, MaterialWindow, SegmentedButton, TextButton,
    TextField, TonalButton,
} from "@material";
import { SakuraTheme } from "sakura-theme.slint";
import { Entry } from "components/app-card.slint";
import { AppList } from "components/app-list.slint";
import { ConfirmDialog } from "components/confirm-dialog.slint";
import { LeftoverPanel } from "components/leftover-panel.slint";
import { ProgressPanel } from "components/progress-panel.slint";
import { ReportPanel } from "components/report-panel.slint";

export { Entry }

export component AppWindow inherits MaterialWindow {
    title: "Sakura Uninstaller";
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 585px;
    default-font-family: "Segoe UI";

    in property <bool> italian;
    in property <bool> busy;
    in property <bool> silent-supported;
    in property <bool> only-portable;
    in property <bool> status-error;
    in property <bool> updates-configured;
    in property <string> update-version;
    in-out property <bool> auto-update;
    in-out property <bool> diagnostics;
    in property <string> diagnostics-host;
    in property <int> selected-count;
    in property <int> available-count;
    in property <int> residue-count;
    in property <int> saved-count;
    in property <[Entry]> entries;
    in property <string> status;
    in property <string> report-text;
    in property <bool> has-report;
    in property <bool> report-has-older;
    in property <int> report-offset;
    in property <string> confirmation-detail;
    in property <bool> offer-leftover-review;
    in-out property <string> search-text;
    in-out property <bool> silent;
    in-out property <int> page;
    in-out property <int> profile-index: 1;
    in-out property <int> filter-index;
    private property <string> primary-label: page == 0
        ? (only-portable ? (italian ? "Cerca residui" : "Scan leftovers") : (italian ? "Disinstalla" : "Uninstall"))
        : page == 1 ? (italian ? "Sposta in quarantena" : "Move to quarantine")
                    : (italian ? "Ripristina" : "Restore");
    private property <string> confirmation-label;
    private property <bool> confirmation-review: true;

    callback load-page(int);
    callback language-changed();
    callback filter-changed();
    callback profile-changed();
    callback measure();
    callback close-apps();
    callback add-portable(string);
    callback check-update();
    callback install-update();
    callback update-preference();
    callback diagnostics-preference();
    callback send-diagnostics();
    callback browse-report(int);
    callback select(string, bool);
    callback select-visible();
    callback clear-selection();
    callback refresh();
    callback preview();
    callback prepare-action();
    callback confirm-action(bool);
    callback open-folder();

    init => { MaterialPalette.schemes = SakuraTheme.schemes; }

    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 12px;

            Image {
                width: 36px;
                height: 36px;
                source: @image-url("icons/sakura.svg");
            }

            MaterialText {
                horizontal-stretch: 1;
                text: "Sakura Uninstaller";
                style: MaterialTypography.headline_small;
                color: MaterialPalette.on_surface;
                vertical-alignment: center;
            }

            TextButton {
                text: root.italian ? "English" : "Italiano";
                clicked => { root.language-changed(); }
            }

            TextButton {
                text: root.italian ? "Registro attività" : "Activity log";
                enabled: !root.busy;
                clicked => { root.open-folder(); }
            }
            TextButton {
                text: root.italian ? "Impostazioni" : "Settings";
                enabled: !root.busy;
                clicked => { settings.show(); }
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            SegmentedButton {
                horizontal-stretch: 0;
                current-index <=> root.page;
                items: [
                    { text: root.italian ? "Software installato" : "Installed software" },
                    { text: root.italian ? "Residui (\{root.residue-count})" : "Leftovers (\{root.residue-count})" },
                    { text: root.italian ? "Quarantena (\{root.saved-count})" : "Quarantine (\{root.saved-count})" }
                ];
                index-changed(index) => { root.load-page(index); }
            }

            Rectangle { horizontal-stretch: 1; }

            if root.page == 0 : TextButton {
                text: root.italian ? "Aggiungi portatile" : "Add portable";
                enabled: !root.busy;
                clicked => { portable-dialog.show(); }
            }

            TextButton {
                text: root.italian ? "Aggiorna" : "Refresh";
                enabled: !root.busy;
                clicked => { root.refresh(); }
            }
        }

        if root.page == 0 : HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            TextField {
                horizontal-stretch: 1;
                label: root.italian ? "Cerca nome, editore o versione" : "Search name, publisher or version";
                leading-icon: @image-url("icons/search.svg");
                accessible-placeholder-text: self.label;
                text <=> root.search-text;
                edited => { root.filter-changed(); }
            }

            DropDownMenu {
                width: 156px;
                current-index <=> root.filter-index;
                label: root.italian ? "Filtro" : "Filter";
                items: [
                    { text: root.italian ? "Tutti" : "All" },
                    { text: root.italian ? "Rimovibili" : "Removable" },
                    { text: "MSIX" },
                    { text: root.italian ? "Portatili" : "Portable" }
                ];
                selected(_) => { root.filter-changed(); }
            }

            DropDownMenu {
                width: 166px;
                enabled: !root.busy;
                current-index <=> root.profile-index;
                label: root.italian ? "Scansione" : "Scan profile";
                items: [
                    { text: root.italian ? "Sicura" : "Safe" },
                    { text: root.italian ? "Equilibrata" : "Balanced" },
                    { text: root.italian ? "Approfondita" : "Deep" }
                ];
                selected(_) => { root.profile-changed(); }
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 12px;

            MaterialText {
                horizontal-stretch: 1;
                text: root.italian
                    ? "\{root.available-count} risultati · \{root.selected-count} selezionati"
                    : "\{root.available-count} results · \{root.selected-count} selected";
                style: MaterialTypography.label_large;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            TextButton {
                text: root.italian ? "Seleziona visibili" : "Select visible";
                enabled: !root.busy && root.available-count > 0;
                clicked => { root.select-visible(); }
            }

            TextButton {
                text: root.italian ? "Deseleziona" : "Clear selection";
                enabled: !root.busy && root.selected-count > 0;
                clicked => { root.clear-selection(); }
            }
        }

        if root.busy : ProgressPanel {}

        if root.entries.length > 0 : AppList {
            vertical-stretch: 1;
            entries: root.entries;
            busy: root.busy;
            select(id, selected) => { root.select(id, selected); }
        }

        if root.entries.length == 0 : LeftoverPanel {
            italian: root.italian;
            busy: root.busy;
            page: root.page;
        }

        if root.status != "" : MaterialText {
            vertical-stretch: 0;
            text: root.status;
            style: MaterialTypography.body_medium;
            color: root.status-error ? MaterialPalette.error : MaterialPalette.on_surface_variant;
            wrap: word-wrap;
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            if root.page == 0 : HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 2px;
                CheckBox {
                    width: 48px;
                    height: 48px;
                    accessible-label: root.italian ? "Modalità silenziosa" : "Quiet mode";
                    enabled: !root.busy && root.silent-supported;
                    check-state: root.silent ? CheckState.checked : CheckState.unchecked;
                    checked-state-changed(state) => {
                        if (state == CheckState.checked) != root.silent {
                            root.silent = state == CheckState.checked;
                        }
                    }
                }
                MaterialText {
                    text: root.italian ? "Modalità silenziosa" : "Quiet mode";
                    style: MaterialTypography.body_medium;
                    color: MaterialPalette.on_surface;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            if root.page == 0 : TonalButton {
                text: root.italian ? "Anteprima" : "Dry run";
                enabled: !root.busy && root.selected-count > 0;
                clicked => {
                    root.preview();
                }
            }

            if root.page == 0 : TextButton {
                text: root.italian ? "Misura" : "Measure";
                enabled: !root.busy && root.selected-count > 0;
                clicked => { root.measure(); }
            }

            if root.page == 0 : TextButton {
                text: root.italian ? "Chiudi app" : "Close apps";
                enabled: !root.busy && root.selected-count > 0;
                clicked => { close-dialog.show(); }
            }

            if root.has-report : TextButton {
                text: root.italian ? "Rapporti" : "Reports";
                enabled: !root.busy;
                clicked => { root.browse-report(0); report.show(); }
            }

            FilledButton {
                text: root.primary-label;
                icon: root.page == 0 ? @image-url("icons/delete.svg") : @image-url("");
                enabled: !root.busy && root.selected-count > 0;
                clicked => {
                    root.confirmation-label = root.primary-label;
                    root.prepare-action();
                    root.confirmation-review = true;
                    confirmation.show();
                }
            }
        }
    }

    close-dialog := Dialog {
        width: root.width;
        height: root.height;
        title: root.italian ? "Chiudi app selezionate" : "Close selected apps";
        actions: [root.italian ? "Annulla" : "Cancel", root.italian ? "Chiedi di chiudere" : "Request close"];
        action-clicked(index) => {
            self.close();
            if index == 1 { root.close-apps(); }
        }
        MaterialText {
            width: 440px;
            wrap: word-wrap;
            text: root.italian ? "Invia una richiesta di chiusura alle finestre attribuite alle app selezionate. Le app possono chiedere di salvare il lavoro." : "Send close requests to windows attributed to the selected apps. Apps may ask you to save your work.";
        }
    }

    settings := Dialog {
        width: root.width;
        height: root.height;
        title: root.italian ? "Impostazioni" : "Settings";
        actions: [root.italian ? "Chiudi" : "Close"];
        action-clicked => { self.close(); }
        VerticalLayout {
            width: 484px;
            spacing: 8px;
            HorizontalLayout {
                CheckBox {
                    width: 48px;
                    enabled: root.updates-configured;
                    accessible-label: root.italian ? "Controllo aggiornamenti automatico" : "Automatic update check";
                    check-state: root.auto-update ? CheckState.checked : CheckState.unchecked;
                    checked-state-changed(state) => {
                        if (state == CheckState.checked) != root.auto-update {
                            root.auto-update = state == CheckState.checked;
                            root.update-preference();
                        }
                    }
                }
                MaterialText {
                    text: root.italian ? "Controlla aggiornamenti all’avvio" : "Check for updates on startup";
                    vertical-alignment: center;
                }
            }
            if !root.updates-configured : MaterialText {
                text: root.italian ? "Il canale firmato non è configurato per questa build." : "This build has no configured signed update channel.";
                wrap: word-wrap;
                color: MaterialPalette.on_surface_variant;
            }
            HorizontalLayout {
                CheckBox {
                    width: 48px;
                    accessible-label: root.italian ? "Diagnostica locale" : "Local diagnostics";
                    check-state: root.diagnostics ? CheckState.checked : CheckState.unchecked;
                    checked-state-changed(state) => {
                        if (state == CheckState.checked) != root.diagnostics {
                            root.diagnostics = state == CheckState.checked;
                            root.diagnostics-preference();
                        }
                    }
                }
                MaterialText {
                    text: root.italian ? "Raccogli contatori diagnostici locali" : "Collect local diagnostic counts";
                    vertical-alignment: center;
                }
            }
            if root.diagnostics-host != "" : VerticalLayout {
                MaterialText {
                    text: root.italian
                        ? "Invia a \{root.diagnostics-host} solo il totale delle operazioni completate e con errori."
                        : "Send only totals of completed and failed operations to \{root.diagnostics-host}.";
                    wrap: word-wrap;
                    color: MaterialPalette.on_surface_variant;
                }
                TextButton {
                    horizontal-stretch: 0;
                    enabled: root.diagnostics && !root.busy;
                    text: root.italian ? "Invia contatori" : "Send counts";
                    clicked => { settings.close(); root.send-diagnostics(); }
                }
            }
            HorizontalLayout {
                TextButton {
                    enabled: root.updates-configured;
                    text: root.italian ? "Cerca aggiornamenti" : "Check for updates";
                    clicked => { settings.close(); root.check-update(); }
                }
                if root.update-version != "" : FilledButton {
                    text: root.italian ? "Installa \{root.update-version}" : "Install \{root.update-version}";
                    clicked => { settings.close(); root.install-update(); }
                }
            }
        }
    }

    portable-dialog := Dialog {
        width: root.width;
        height: root.height;
        title: root.italian ? "Aggiungi app portatile" : "Add portable app";
        actions: [root.italian ? "Annulla" : "Cancel", root.italian ? "Aggiungi" : "Add"];
        action-clicked(index) => {
            if index == 1 { root.add-portable(portable-path.text); }
            self.close();
        }
        portable-path := TextField {
            width: 488px;
            label: root.italian ? "Percorso completo del file .exe" : "Full path to the .exe";
        }
    }

    confirmation := ConfirmDialog {
        width: root.width;
        height: root.height;
        title: root.confirmation-label;
        italian: root.italian;
        details: root.confirmation-detail;
        offer-review: root.offer-leftover-review;
        review-after <=> root.confirmation-review;
        confirmed(review) => { root.confirm-action(review); }
    }

    report := ReportPanel {
        width: root.width;
        height: root.height;
        italian: root.italian;
        report-text: root.report-text;
        has-newer: root.report-offset > 0;
        has-older: root.report-has-older;
        browse(direction) => { root.browse-report(direction); }
    }
}

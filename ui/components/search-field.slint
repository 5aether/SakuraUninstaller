import { Icon, MaterialPalette, MaterialText, MaterialTypography } from "@material";

export component SearchField {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> enabled: true;

    callback edited(string);

    height: 64px;

    background_layer := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 32px;
        background: MaterialPalette.surface_container_high;
        border-width: input.has-focus ? 1px : 0px;
        border-color: MaterialPalette.primary;
        clip: true;

        HorizontalLayout {
            padding-left: 26px;
            padding-right: 23px;
            spacing: 12px;

            Rectangle {
                horizontal-stretch: 1;

                input := TextInput {
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    vertical-alignment: center;
                    single-line: true;
                    enabled: root.enabled;
                    color: MaterialPalette.on_surface;
                    font-size: MaterialTypography.body_large.font_size;
                    letter-spacing: 0.5px;
                    selection-background-color: MaterialPalette.primary.with_alpha(0.45);
                    selection-foreground-color: MaterialPalette.on_surface;
                    text <=> root.text;

                    edited => { root.edited(self.text); }
                }

                if root.text == "" && !input.has-focus : MaterialText {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    text: root.placeholder;
                    style: MaterialTypography.body_large;
                    letter-spacing: 0.5px;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            VerticalLayout {
                alignment: center;

                Icon {
                    source: @image-url("../icons/search.svg");
                    colorize: MaterialPalette.on_surface_variant;
                    width: 20px;
                }
            }
        }
    }
}

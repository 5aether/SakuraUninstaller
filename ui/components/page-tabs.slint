import { MaterialPalette, MaterialText, MaterialTypography, StateLayerArea } from "@material";

export struct TabItem {
    text: string,
    count: int,
    show_count: bool,
}

component CountBadge {
    in property <int> count;

    width: max(18px, label.width + 12px);
    height: 18px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 9px;
        background: MaterialPalette.error;
    }

    label := MaterialText {
        text: "\{root.count}";
        style: MaterialTypography.label_small;
        color: MaterialPalette.on_error;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TabPill {
    in property <TabItem> item;
    in property <bool> selected;

    callback activated();

    height: 40px;

    accessible-role: tab;
    accessible-label: root.item.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.activated(); }

    state_area := StateLayerArea {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        color: MaterialPalette.on_surface;
        clicked => { root.activated(); }

        if root.selected : Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 20px;
            background: MaterialPalette.secondary_container;
        }

        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            spacing: 8px;

            MaterialText {
                text: root.item.text;
                style: MaterialTypography.label_large;
                letter-spacing: 0.1px;
                color: root.selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            if root.item.show_count : VerticalLayout {
                alignment: center;

                CountBadge { count: root.item.count; }
            }
        }
    }
}

export component PageTabs inherits HorizontalLayout {
    in property <[TabItem]> items;
    in-out property <int> current-index;

    callback activated(int);

    height: 40px;
    spacing: 10px;
    alignment: center;

    for item[index] in root.items : TabPill {
        item: item;
        selected: index == root.current-index;

        activated => {
            root.current-index = index;
            root.activated(index);
        }
    }
}

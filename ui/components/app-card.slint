import {
    CheckBox, CheckState, MaterialPalette, MaterialText, MaterialTypography,
} from "@material";

export struct Entry {
    id: string,
    title: string,
    description: string,
    size: string,
    initial: string,
    icon: image,
    selectable: bool,
    selected: bool,
}

export component AppCard {
    in property <Entry> item;
    in property <bool> enabled;
    in property <bool> show-details: true;
    callback select(bool);

    height: root.show-details ? 64px : 56px;

    background_layer := Rectangle {
        width: 100%;
        height: 100%;

        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            spacing: 16px;

            avatar := Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: root.item.icon.width > 0 || root.item.icon.height > 0
                    ? transparent
                    : MaterialPalette.primary_container;
                clip: true;

                if root.item.icon.width > 0 && root.item.icon.height > 0 : Image {
                    width: 100%;
                    height: 100%;
                    source: root.item.icon;
                    image-fit: contain;
                }

                if root.item.icon.width == 0 || root.item.icon.height == 0 : MaterialText {
                    text: root.item.initial;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: MaterialPalette.on_primary_container;
                    style: MaterialTypography.title_medium;
                }
            }

            title_layout := Rectangle {
                horizontal-stretch: 1;
                clip: true;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: start;
                    spacing: 1px;

                    MaterialText {
                        text: root.item.title;
                        style: MaterialTypography.body_large;
                        color: root.item.selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                        overflow: elide;
                        vertical-stretch: 0;
                    }

                    if root.show-details && root.item.description != "" : MaterialText {
                        text: root.item.description;
                        style: MaterialTypography.body_small;
                        color: root.item.selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                        overflow: elide;
                        vertical-stretch: 0;
                    }
                }
            }

            if root.show-details && root.item.size != "" : MaterialText {
                text: root.item.size;
                style: MaterialTypography.label_large;
                color: root.item.selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            CheckBox {
                width: 48px;
                height: 48px;
                accessible-label: root.item.title;
                enabled: root.enabled && root.item.selectable;
                check-state: root.item.selected ? CheckState.checked : CheckState.unchecked;

                checked-state-changed(state) => {
                    if (state == CheckState.checked) != root.item.selected {
                        root.select(state == CheckState.checked);
                    }
                }
            }
        }
    }
}
